# Version control
.git
.gitignore
.gitattributes

# Python caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual envs (never bake these into the image)
venv/
.venv/
env/
ENV/

# Streamlit / IDE state
.streamlit/secrets.toml
.vscode/
.idea/
*.swp
*.swo

# Local data — the entrypoint seeds these from a template at first boot,
# so don't ship host-specific copies in the image.
portfolio.json
portfolio_us.json
session.json

# Docker-adjacent files (no need to ship inside the image)
# NOTE: do NOT exclude docker-entrypoint.sh here — the Dockerfile
# COPYs it into the image at /usr/local/bin/docker-entrypoint.sh.
Dockerfile
.dockerignore
docker-compose.yml

# CI / meta
.github/
.kiro/
.replit
.replitignore
.npmrc
artifacts/
*.md
!README.md
